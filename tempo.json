  "description": "Complete Tempo-based API monitoring: RED metrics, per-endpoint & per-route analysis, error tracking, trace/log correlation, and Tempo platform health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
