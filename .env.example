[TEMPLATE]
# .env.example
# ── Database ──────────────────────────────
POSTGRES_DB=mapdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# ── Forecast DB (external, read-only) ─────
# Schema: forecast | Table: forecast_hex_hourly
# Either set FORECAST_DATABASE_URL, or the parts below.
FORECAST_DB_HOST=127.0.0.1
FORECAST_DB_PORT=5432
FORECAST_DB_USER=postgres
FORECAST_DB_PASSWORD=change_me_in_production
FORECAST_DB_NAME=postgres
FORECAST_DB_SCHEMA=forecast
# Optional tuning (defaults shown)
# FORECAST_DB_CONNECT_TIMEOUT=10          # seconds, fail fast if DB unreachable
# FORECAST_DB_STATEMENT_TIMEOUT_MS=15000  # hard cap per query
# FORECAST_DB_COUNT_TIMEOUT_MS=60000      # only used with include_total=true

# ── JWT ───────────────────────────────────
SECRET_KEY=change-this-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────
APP_ENV=development
APP_NAME="Map Platform"
DEBUG=true
ALLOWED_ORIGINS=["http://localhost","http://localhost:8001"]

# ── External black-box services ───────────
SERVICE1_URL=http://service1:8001
SERVICE2_URL=http://service2:8002
SERVICE3_URL=http://service3:8003
SERVICE4_URL=http://service4:8004
SERVICE_TIMEOUT=30

# ── API gateway (Traefik) ─────────────────
# The single host the frontend talks to. Traefik builds its router rules
# from this, so it must match the nginx server block
# (docker/traefik/nginx/gateway.kashefteam.org.conf) and the literal
# host used in docker/traefik/dynamic/external-services.yml.
DOMAIN=gateway.kashefteam.org
# Loopback ports Traefik is published on. nginx proxies to
# TRAEFIK_HTTP_PORT; TRAEFIK_API_PORT serves the dashboard and /metrics.
TRAEFIK_HTTP_PORT=8090
TRAEFIK_API_PORT=8080
